COLUMN TABLE "DOCUMENT_CHUNKS" (
    "CHUNK_ID" INTEGER NOT NULL,
    "DOCUMENT_ID" NVARCHAR(100) NOT NULL,
    "CHUNK_INDEX" INTEGER NOT NULL,
    "TITLE" NVARCHAR(500),
    "TOPIC" NVARCHAR(200),
    "SOURCE_URL" NVARCHAR(2000),
    "CHUNK_TEXT" NVARCHAR(5000) NOT NULL,
    "EMBEDDING" REAL_VECTOR(384),
    "INGESTED_AT" TIMESTAMP,
    PRIMARY KEY ("CHUNK_ID")
)